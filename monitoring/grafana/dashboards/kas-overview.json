{
  "uid": "kas-overview",
  "title": "KAS Overview",
  "description": "KAS SDK 预置运维看板（v1.3，ADR-0003 路线 A）：状态/成功率/时延/阶段/缓存/降级/余额/熔断",
  "tags": [
    "kas"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Evidence Provider",
      "datasource": {
        "type": "prometheus",
        "uid": "kas-prom"
      },
      "description": "必需组件",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kas-prom"
          },
          "expr": "max(kas_health_status{component=\"evidence_provider\",status=\"healthy\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      }
    },
