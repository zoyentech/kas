        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "问答成功率 %",
      "datasource": {
        "type": "prometheus",
        "uid": "kas-prom"
      },
      "description": "err==nil 且 action∈{answer,ask_clarification,abstain}（degraded 计成功单列）",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kas-prom"
          },
          "expr": "100 * sum(rate(kas_requests_total{outcome=~\"ok|degraded\"}[5m])) / clamp_min(sum(rate(kas_requests_total[5m])), 1e-9)",
          "refId": "A",
          "legendFormat": "success_rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
