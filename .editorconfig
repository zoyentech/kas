# EditorConfig — 格式统一（Story 1.2.1.2）。Go 以 gofumpt 为准，本文件约束
# 非 Go 文件的基础格式。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
